<Project Sdk="Microsoft.NET.Sdk">
  <!-- Interop driver for csharp/ltx: compiles the port's sources with Driver.cs
       (see scripts/interop/run.js). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>build/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>build/obj/</BaseIntermediateOutputPath>
    <NoWarn>$(NoWarn);CS8600;CS8602;CS8604;CS8618;CS0168;CS0219</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NSec.Cryptography" Version="24.4.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../../../csharp/ltx/src/*.cs" />
    <Compile Include="Driver.cs" />
  </ItemGroup>
</Project>
