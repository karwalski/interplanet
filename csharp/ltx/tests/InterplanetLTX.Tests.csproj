<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test runner for ../InterplanetLTX.csproj; run it with: dotnet run (project dir tests) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>InterplanetLTX.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../InterplanetLTX.csproj" />
  </ItemGroup>
</Project>
