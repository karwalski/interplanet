f=printusage():i64{
  io.println("interplanet: Interplanetary Time CLI (toke port)");
  io.println("");
  io.println("Commands:");
  io.println("  time <planet> [--tz <hours>]    Local time on a planet");
  io.println("  mtc                             Mars Coordinated Time");
  io.println("  light <from> <to>               One-way light travel time");
  io.println("  distance <from> <to>            Distance in AU and km");
  io.println("  los <from> <to>                 Line-of-sight status");
  io.println("  windows <a> <b> [--days <n>]    Meeting windows (15 min steps)");
  io.println("  planets                         List supported planets");
  io.println("  ltx <title> <name:role:location[:delay]>...  LTX v2 plan and planId");
  io.println("  planid <plan-json>              v2 planId of a JSON.stringify'd plan");
  io.println("");
  io.println("Every command except planid accepts --at <utc-ms> (default: now).");
  io.println("ltx also accepts --quantum <min> and --mode <mode>.");
  io.println("Planets: mercury venus earth mars jupiter saturn uranus neptune moon");
  <0
};

f=cmdplanets():i64{
  io.println("Supported planets:");
  io.println("  mercury   Solar day 175.9 Earth days");
  io.println("  venus     Solar day 116.8 Earth days");
  io.println("  earth     Solar day 24h");
  io.println("  mars      Sol 24h 39m 35s");
  io.println("  jupiter   Day 9.9h");
  io.println("  saturn    Day 10.6h");
  io.println("  uranus    Day 17.2h");
  io.println("  neptune   Day 16.1h");
  io.println("  moon      Tidally locked (uses Earth time)");
  <0
};

f=badplanet(key:$str):i64{
  io.eprintln(str.concat("Unknown planet: ";key));
  <1
};

f=cmdtime(planet:$str;tz:f64;now:f64):i64{
  if(!isvalidplanet(planet)){<badplanet(planet)};
  let r=getplanettime(planet;now;tz);
  io.println(str.concat(r.planet;" local time:"));
  io.println(str.concat("  UTC:            ";isoutc(math.floor(now) as i64)));
  io.println(str.concat("  Time:           ";r.timestrfull));
  io.println(str.concat("  Day:            ";r.downame));
  io.println(str.concat("  Day number:     ";str.fromint(r.daynumber)));
  io.println(str.concat("  Day fraction:   ";fmtfix(r.dayfraction;12)));
  io.println(str.concat("  Local hour:     ";fmtfix(r.localhour;12)));
  io.println(str.concat("  Year:           ";str.fromint(r.yearnumber)));
  io.println(str.concat("  Day in year:    ";str.fromint(r.dayinyear)));
  io.println(str.concat("  Period in week: ";str.fromint(r.periodinweek)));
  io.println(str.concat("  Work period:    ";yesno(r.isworkperiod)));
  io.println(str.concat("  Work hour:      ";yesno(r.isworkhour)));
  if(planet=="mars"){
    io.println(str.concat("  Sol in year:    ";str.fromint(r.solinyear)));
    io.println(str.concat("  Sols/year:      ";str.fromint(r.solsperyear)));
    let m=getmtc(now);
    io.println(str.concat("  MTC:            ";m.mtcstr))
  };
  if(!(planet=="earth"||planet=="moon")){
    io.println(str.concat("  Light (Earth):  ";str.concat(fmtfix(lighttravelseconds("earth";planet;now);6);" s")))
  };
  io.println(str.concat("  Helio r:        ";str.concat(fmtfix(planethelioxy(planet;now).r;9);" AU")));
  <0
};

f=cmdmtc(now:f64):i64{
  let m=getmtc(now);
  io.println("Mars Coordinated Time (MTC):");
  io.println(str.concat("  MTC:  ";m.mtcstr));
  io.println(str.concat("  Sol:  ";str.fromint(m.sol)));
  io.println(str.concat("  Time: ";str.concat(padtwo(m.hour);str.concat(":";str.concat(padtwo(m.minute);str.concat(":";padtwo(m.second)))))));
  <0
};

f=cmdlight(a:$str;b:$str;now:f64):i64{
  if(!isvalidplanet(a)){<badplanet(a)};
  if(!isvalidplanet(b)){<badplanet(b)};
  let secs=lighttravelseconds(a;b;now);
  let au=bodydistance(a;b;now);
  io.println(str.concat("Light travel: ";str.concat(planetget(a).pname;str.concat(" -> ";planetget(b).pname))));
  io.println(str.concat("  Time:     ";formatlighttime(secs)));
  io.println(str.concat("  Seconds:  ";fmtfix(secs;3)));
  io.println(str.concat("  Distance: ";str.concat(fmtfix(au;6);" AU")));
  <0
};

f=cmddistance(a:$str;b:$str;now:f64):i64{
  if(!isvalidplanet(a)){<badplanet(a)};
  if(!isvalidplanet(b)){<badplanet(b)};
  let au=bodydistance(a;b;now);
  io.println(str.concat("Distance: ";str.concat(planetget(a).pname;str.concat(" - ";planetget(b).pname))));
  io.println(str.concat("  AU:  ";fmtfix(au;6)));
  io.println(str.concat("  km:  ";fmtfix(au*aukm();0)));
  <0
};

f=cmdlos(a:$str;b:$str;now:f64):i64{
  if(!isvalidplanet(a)){<badplanet(a)};
  if(!isvalidplanet(b)){<badplanet(b)};
  let l=checklos(a;b;now);
  let status=mut."CLEAR";
  if(l.blocked){status="BLOCKED"};
  if(l.degraded){status="DEGRADED"};
  io.println(str.concat("Line of sight: ";str.concat(planetget(a).pname;str.concat(" - ";planetget(b).pname))));
  io.println(str.concat("  Status:   ";l.message));
  io.println(str.concat("  Signal:   ";status));
  io.println(str.concat("  Sun dist: ";str.concat(fmtfix(l.closestsunau;6);" AU")));
  io.println(str.concat("  Elong:    ";str.concat(fmtfix(l.edeg;3);" deg")));
  <0
};

f=cmdwindows(a:$str;b:$str;days:i64;now:f64):i64{
  if(!isvalidplanet(a)){<badplanet(a)};
  if(!isvalidplanet(b)){<badplanet(b)};
  let ws=findmeetingwindows(a;b;days;now);
  io.println(str.concat("Meeting windows: ";str.concat(planetget(a).pname;str.concat(" & ";str.concat(planetget(b).pname;str.concat(" (";str.concat(str.fromint(days);" days)")))))));
  if(ws.len==0){io.println("  No overlapping work windows found.")};
  lp(let i=0;i<(ws.len as i64);i=i+1){
    let w=ws.get(i as u64);
    io.println(str.concat("  ";str.concat(isoutc(w.wstart);str.concat(" to ";str.concat(isoutc(w.wend);str.concat("  (";str.concat(str.fromint(w.wdur);" min)")))))))
  };
  io.println(str.concat("  Total windows: ";str.fromint(ws.len as i64)));
  <0
};

f=segjson(t:$str;q:i64):$str{
  <str.concat("{\"type\":";str.concat(jsonstr(t);str.concat(",\"q\":";str.concat(str.fromint(q);"}"))))
};

f=cmdltx(title:$str;first:i64;now:f64):i64{
  let n=args.count() as i64;
  let startms=(math.floor(now/60000.0) as i64)*60000;
  let startiso=isoutc(startms);
  let quantum=mut.5;
  let qs=optval("--quantum");
  if(!(qs=="")){
    quantum=mt str.toint(qs) {
      $ok:v v;
      $err:e 5
    }
  };
  let mode=mut."LTX";
  let ms=optval("--mode");
  if(!(ms=="")){mode=ms};

  let names=mut.@("");
  let nodesjson=mut."";
  let count=mut.0;
  let skip=mut.false;
  lp(let i=first;i<n;i=i+1){
    let a=argat(i);
    if(skip){skip=false}el{
      if(str.startswith(a;"--")){skip=true}el{
        let parts=str.split(a;":");
        if(parts.len<3){
          io.eprintln(str.concat("Invalid node (name:role:location[:delay]): ";a));
          <1
        };
        let name=parts.get(0 as u64);
        let role=parts.get(1 as u64);
        let loc=parts.get(2 as u64);
        let delay=mut.0;
        if(parts.len>3){
          delay=mt str.toint(parts.get(3 as u64)) {
            $ok:d d;
            $err:e 0
          }
        }el{
          if(count>0&&isvalidplanet(loc)){
            delay=math.floor(lighttravelseconds(argnodeloc(first);loc;now)+0.5) as i64
          }
        };
        let nid=str.concat("N";str.fromint(count));
        let nj=str.concat("{\"id\":";str.concat(jsonstr(nid);str.concat(",\"name\":";str.concat(jsonstr(name);
          str.concat(",\"role\":";str.concat(jsonstr(role);str.concat(",\"delay\":";str.concat(str.fromint(delay);
          str.concat(",\"location\":";str.concat(jsonstr(loc);"}"))))))))));
        if(count==0){nodesjson=nj;names=@(name)}el{
          nodesjson=str.concat(nodesjson;str.concat(",";nj));
          names=names.push(name)
        };
        count=count+1
      }
    }
  };
  if(count==0){
    io.eprintln("ltx: at least one node is required");
    <1
  };

  let segs=mut.segjson("PLAN_CONFIRM";2);
  segs=str.concat(segs;str.concat(",";segjson("TX";2)));
  segs=str.concat(segs;str.concat(",";segjson("RX";2)));
  segs=str.concat(segs;str.concat(",";segjson("CAUCUS";2)));
  segs=str.concat(segs;str.concat(",";segjson("TX";2)));
  segs=str.concat(segs;str.concat(",";segjson("RX";2)));
  segs=str.concat(segs;str.concat(",";segjson("BUFFER";1)));
  let json=str.concat("{\"v\":2,\"title\":";str.concat(jsonstr(title);str.concat(",\"start\":";str.concat(jsonstr(startiso);
    str.concat(",\"quantum\":";str.concat(str.fromint(quantum);str.concat(",\"mode\":";str.concat(jsonstr(mode);
    str.concat(",\"segments\":[";str.concat(segs;str.concat("],\"nodes\":[";str.concat(nodesjson;"]}"))))))))))));

  io.println("LTX Session Plan (v2):");
  io.println(str.concat("  Plan ID:  ";planidfrom(json;startiso;names)));
  io.println(str.concat("  Title:    ";title));
  io.println(str.concat("  Start:    ";startiso));
  io.println(str.concat("  Mode:     ";mode));
  io.println(str.concat("  Quantum:  ";str.concat(str.fromint(quantum);" min")));
  io.println(str.concat("  Duration: ";str.concat(str.fromint(13*quantum);" min")));
  let qms=quantum*60000;
  let cursor=mut.startms;
  let types=@("PLAN_CONFIRM";"TX";"RX";"CAUCUS";"TX";"RX";"BUFFER");
  let qs2=@(2;2;2;2;2;2;1);
  io.println("  Segments:");
  lp(let k=0;k<7;k=k+1){
    let e=cursor+qs2.get(k as u64)*qms;
    io.println(str.concat("    ";str.concat(types.get(k as u64);str.concat("  ";str.concat(isoutc(cursor);str.concat(" to ";isoutc(e)))))));
    cursor=e
  };
  io.println(str.concat("  JSON:     ";json));
  <0
};

(* location of the first node argument, used as the delay reference *)
f=argnodeloc(first:i64):$str{
  let parts=str.split(argat(first);":");
  if(parts.len<3){<"earth"};
  <parts.get(2 as u64)
};

f=main():i64{
  let count=args.count() as i64;
  if(count<2){<printusage()};
  let cmd=argat(1);
  if(cmd=="--help"||cmd=="help"){<printusage()};
  if(cmd=="planets"){<cmdplanets()};
  if(cmd=="planid"){
    if(count<3){
      io.eprintln("Usage: interplanet planid <plan-json>");
      <1
    };
    let j=argat(2);
    if(!str.startswith(j;"{\"v\":2,")){
      io.eprintln("planid: only v2 plans (JSON.stringify text starting {\"v\":2,) are supported");
      <1
    };
    io.println(planidjson(j));
    <0
  };
  let now=nowms();
  if(cmd=="mtc"){<cmdmtc(now)};
  if(cmd=="time"){
    if(count<3){
      io.eprintln("Usage: interplanet time <planet> [--tz <hours>] [--at <utc-ms>]");
      <1
    };
    let tzs=optval("--tz");
    let tz=mt str.tofloat(tzs) {
      $ok:v v;
      $err:e 0.0
    };
    <cmdtime(str.lower(argat(2));tz;now)
  };
  if(cmd=="ltx"){
    if(count<4){
      io.eprintln("Usage: interplanet ltx <title> <name:role:location[:delay]>... [--at <utc-ms>] [--quantum <min>] [--mode <mode>]");
      <1
    };
    <cmdltx(argat(2);3;now)
  };
  if(count<4){
    if(cmd=="light"||cmd=="distance"||cmd=="los"||cmd=="windows"){
      io.eprintln(str.concat("Usage: interplanet ";str.concat(cmd;" <from> <to>")));
      <1
    }
  };
  let a=str.lower(argat(2));
  let b=str.lower(argat(3));
  if(cmd=="light"||cmd=="light-travel"){<cmdlight(a;b;now)};
  if(cmd=="distance"){<cmddistance(a;b;now)};
  if(cmd=="los"){<cmdlos(a;b;now)};
  if(cmd=="windows"){
    let ds=optval("--days");
    let days=mt str.toint(ds) {
      $ok:v v;
      $err:e 7
    };
    <cmdwindows(a;b;days;now)
  };
  io.eprintln(str.concat("Unknown command: ";cmd));
  printusage();
  <1
};
