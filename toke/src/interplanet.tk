m=interplanet;
i=io:std.io;
i=str:std.str;
i=args:std.args;
i=math:std.math;
i=time:std.time;

(* interplanet: toke port of the InterPlanet planet-time and LTX demo CLI.
   Single compilation unit: toke 3.0.0 multi-file builds do not link on
   Linux (the per-module .ll paths reach clang as one argument), so the
   former planettime / ltx / cli modules live in this one file. *)

t=$orbital{l0:f64;dl:f64;om0:f64;e0:f64;a:f64};

t=$helio{x:f64;y:f64;r:f64;lon:f64};

t=$planetinfo{
  pname:$str;solarday:f64;sidyr:f64;
  daysperperiod:f64;periodsperweek:i64;workperiodsperweek:i64;
  workhrsstart:i64;workhrsend:i64;
  earthclocksched:bool;epoch:f64
};

(* at most 16 fields per struct (tkc --max-params default) *)
t=$planettime{
  planet:$str;hour:i64;minute:i64;second:i64;
  localhour:f64;dayfraction:f64;daynumber:i64;
  dayinyear:i64;yearnumber:i64;
  periodinweek:i64;isworkperiod:bool;isworkhour:bool;
  downame:$str;timestrfull:$str;
  solinyear:i64;solsperyear:i64
};

t=$mtc{sol:i64;hour:i64;minute:i64;second:i64;mtcstr:$str};

t=$los{clear:bool;blocked:bool;degraded:bool;closestsunau:f64;edeg:f64;message:$str};

t=$window{wstart:i64;wend:i64;wdur:i64};

(* ── Constants ───────────────────────────────────────────────────── *)

f=aukm():f64{<149597870.7};
f=ckms():f64{<299792.458};
f=auseconds():f64{<aukm()/ckms()};
f=j2000ms():f64{<946728000000.0};
f=marsepochms():f64{<0.0-524069761536.0};
f=marssolms():f64{<88775244.0};

(* ── Small helpers ───────────────────────────────────────────────── *)

f=imod(a:i64;b:i64):i64{
  <a-a/b*b
};

f=posimod(a:i64;b:i64):i64{
  <imod(imod(a;b)+b;b)
};

f=padtwo(n:i64):$str{
  let s=str.fromint(n);
  if(n<10){<str.concat("0";s)};
  <s
};

f=padleft(s:$str;width:i64;fill:$str):$str{
  let r=mut.s;
  lp(let i=0;(str.len(r) as i64)<width;i=i+1){
    r=str.concat(fill;r)
  };
  <r
};

f=pow10(n:i64):i64{
  let r=mut.1;
  lp(let i=0;i<n;i=i+1){r=r*10};
  <r
};

(* fixed-point decimal rendering of an f64, rounded half away from zero *)
f=fmtfix(x:f64;dp:i64):$str{
  let neg=x<0.0;
  let ax=mut.x;
  if(neg){ax=0.0-x};
  let scale=pow10(dp);
  let scaled=math.floor(ax*(scale as f64)+0.5) as i64;
  let ip=scaled/scale;
  let fp=scaled-ip*scale;
  let body=mut.str.fromint(ip);
  if(dp>0){
    body=str.concat(body;str.concat(".";padleft(str.fromint(fp);dp;"0")))
  };
  if(neg&&scaled>0){<str.concat("-";body)};
  <body
};

f=hexdigit(d:i64):$str{
  <mt str.slice("0123456789abcdef";d as u64;(d+1) as u64) {
    $ok:c c;
    $err:e "0"
  }
};

f=hex8(n:i64):$str{
  let r=mut."";
  let v=mut.n;
  lp(let i=0;i<8;i=i+1){
    r=str.concat(hexdigit(imod(v;16));r);
    v=v/16
  };
  <r
};

f=yesno(b:bool):$str{
  if(b){<"yes"};
  <"no"
};

f=isoutc(ms:i64):$str{
  let tp=time.toparts(ms as u64);
  let msr=posimod(ms;1000);
  <str.concat(str.fromint(tp.year);str.concat("-";str.concat(padtwo(tp.month);
    str.concat("-";str.concat(padtwo(tp.day);str.concat("T";str.concat(padtwo(tp.hour);
    str.concat(":";str.concat(padtwo(tp.min);str.concat(":";str.concat(padtwo(tp.sec);
    str.concat(".";str.concat(padleft(str.fromint(msr);3;"0");"Z")))))))))))))
};

(* ── Planet data ─────────────────────────────────────────────────── *)

f=orbitalget(key:$str):$orbital{
  if(key=="mercury"){<$orbital{l0:252.2507;dl:149474.0722;om0:77.4561;e0:0.20564;a:0.38710}};
  if(key=="venus"){<$orbital{l0:181.9798;dl:58519.2130;om0:131.5637;e0:0.00677;a:0.72333}};
  if(key=="mars"){<$orbital{l0:355.4330;dl:19141.6964;om0:336.0600;e0:0.09341;a:1.52366}};
  if(key=="jupiter"){<$orbital{l0:34.3515;dl:3036.3027;om0:14.3320;e0:0.04849;a:5.20336}};
  if(key=="saturn"){<$orbital{l0:50.0775;dl:1223.5093;om0:93.0572;e0:0.05551;a:9.53707}};
  if(key=="uranus"){<$orbital{l0:314.0550;dl:429.8633;om0:173.0052;e0:0.04630;a:19.1912}};
  if(key=="neptune"){<$orbital{l0:304.3480;dl:219.8997;om0:48.1234;e0:0.00899;a:30.0690}};
  <$orbital{l0:100.4664;dl:36000.7698;om0:102.9373;e0:0.01671;a:1.00000}
};

f=planetget(key:$str):$planetinfo{
  let eday=86400000.0;
  if(key=="mercury"){<$planetinfo{pname:"Mercury";solarday:175.9408*eday;sidyr:87.9691*eday;daysperperiod:1.0;periodsperweek:7;workperiodsperweek:5;workhrsstart:9;workhrsend:17;earthclocksched:true;epoch:j2000ms()}};
  if(key=="venus"){<$planetinfo{pname:"Venus";solarday:116.7500*eday;sidyr:224.701*eday;daysperperiod:1.0;periodsperweek:7;workperiodsperweek:5;workhrsstart:9;workhrsend:17;earthclocksched:true;epoch:j2000ms()}};
  if(key=="mars"){<$planetinfo{pname:"Mars";solarday:marssolms();sidyr:686.9957*eday;daysperperiod:1.0;periodsperweek:7;workperiodsperweek:5;workhrsstart:9;workhrsend:17;earthclocksched:false;epoch:marsepochms()}};
  if(key=="jupiter"){<$planetinfo{pname:"Jupiter";solarday:9.9250*3600000.0;sidyr:4332.589*eday;daysperperiod:2.5;periodsperweek:7;workperiodsperweek:5;workhrsstart:8;workhrsend:16;earthclocksched:false;epoch:j2000ms()}};
  if(key=="saturn"){<$planetinfo{pname:"Saturn";solarday:10.578*3600000.0;sidyr:10759.22*eday;daysperperiod:2.25;periodsperweek:7;workperiodsperweek:5;workhrsstart:8;workhrsend:16;earthclocksched:false;epoch:j2000ms()}};
  if(key=="uranus"){<$planetinfo{pname:"Uranus";solarday:17.2479*3600000.0;sidyr:30688.5*eday;daysperperiod:1.0;periodsperweek:7;workperiodsperweek:5;workhrsstart:8;workhrsend:16;earthclocksched:false;epoch:j2000ms()}};
  if(key=="neptune"){<$planetinfo{pname:"Neptune";solarday:16.1100*3600000.0;sidyr:60195.0*eday;daysperperiod:1.0;periodsperweek:7;workperiodsperweek:5;workhrsstart:8;workhrsend:16;earthclocksched:false;epoch:j2000ms()}};
  if(key=="moon"){<$planetinfo{pname:"Moon";solarday:86400000.0;sidyr:365.25636*eday;daysperperiod:1.0;periodsperweek:7;workperiodsperweek:5;workhrsstart:9;workhrsend:17;earthclocksched:false;epoch:j2000ms()}};
  <$planetinfo{pname:"Earth";solarday:86400000.0;sidyr:365.25636*eday;daysperperiod:1.0;periodsperweek:7;workperiodsperweek:5;workhrsstart:9;workhrsend:17;earthclocksched:false;epoch:j2000ms()}
};

f=isvalidplanet(key:$str):bool{
  <key=="mercury"||key=="venus"||key=="earth"||key=="mars"||key=="jupiter"||key=="saturn"||key=="uranus"||key=="neptune"||key=="moon"
};

(* ── Time scales ─────────────────────────────────────────────────── *)

f=gettaiutc(utcms:f64):f64{
  let offset=mut.10.0;
  if(!(utcms<63072000000.0)){offset=10.0};
  if(!(utcms<78796800000.0)){offset=11.0};
  if(!(utcms<94694400000.0)){offset=12.0};
  if(!(utcms<126230400000.0)){offset=13.0};
  if(!(utcms<157766400000.0)){offset=14.0};
  if(!(utcms<189302400000.0)){offset=15.0};
  if(!(utcms<220924800000.0)){offset=16.0};
  if(!(utcms<252460800000.0)){offset=17.0};
  if(!(utcms<283996800000.0)){offset=18.0};
  if(!(utcms<315532800000.0)){offset=19.0};
  if(!(utcms<362793600000.0)){offset=20.0};
  if(!(utcms<394329600000.0)){offset=21.0};
  if(!(utcms<425865600000.0)){offset=22.0};
  if(!(utcms<489024000000.0)){offset=23.0};
  if(!(utcms<567993600000.0)){offset=24.0};
  if(!(utcms<631152000000.0)){offset=25.0};
  if(!(utcms<662688000000.0)){offset=26.0};
  if(!(utcms<709948800000.0)){offset=27.0};
  if(!(utcms<741484800000.0)){offset=28.0};
  if(!(utcms<773020800000.0)){offset=29.0};
  if(!(utcms<820454400000.0)){offset=30.0};
  if(!(utcms<867715200000.0)){offset=31.0};
  if(!(utcms<915148800000.0)){offset=32.0};
  if(!(utcms<1136073600000.0)){offset=33.0};
  if(!(utcms<1230768000000.0)){offset=34.0};
  if(!(utcms<1341100800000.0)){offset=35.0};
  if(!(utcms<1435708800000.0)){offset=36.0};
  if(!(utcms<1483228800000.0)){offset=37.0};
  <offset
};

f=tojde(utcms:f64):f64{
  let ttms=utcms+(gettaiutc(utcms)+32.184)*1000.0;
  <2440587.5+ttms/86400000.0
};

f=juliancenturies(utcms:f64):f64{
  <(tojde(utcms)-2451545.0)/36525.0
};

(* ── Orbital mechanics ───────────────────────────────────────────── *)

f=keplere(mrad:f64;e:f64):f64{
  let bige=mut.mrad;
  let done=mut.false;
  lp(let i=0;i<50&&!done;i=i+1){
    let de=(mrad-bige+e*math.sin(bige))/(1.0-e*math.cos(bige));
    bige=bige+de;
    if(math.fabs(de)<0.000000000001){done=true}
  };
  <bige
};

f=posmod(x:f64;m:f64):f64{
  <math.fmod(math.fmod(x;m)+m;m)
};

f=planethelioxy(key:$str;utcms:f64):$helio{
  let orb=orbitalget(key);
  let jc=juliancenturies(utcms);
  let d2r=3.141592653589793/180.0;
  let tau=2.0*3.141592653589793;
  let l=posmod((orb.l0+orb.dl*jc)*d2r;tau);
  let om=orb.om0*d2r;
  let mm=posmod(l-om;tau);
  let e=orb.e0;
  let bige=keplere(mm;e);
  let v=2.0*math.atan2(math.sqrt(1.0+e)*math.sin(bige/2.0);math.sqrt(1.0-e)*math.cos(bige/2.0));
  let r=orb.a*(1.0-e*math.cos(bige));
  let lon=posmod(v+om;tau);
  <$helio{x:r*math.cos(lon);y:r*math.sin(lon);r:r;lon:lon}
};

f=bodydistance(keya:$str;keyb:$str;utcms:f64):f64{
  let pa=planethelioxy(keya;utcms);
  let pb=planethelioxy(keyb;utcms);
  let dx=pa.x-pb.x;
  let dy=pa.y-pb.y;
  <math.sqrt(dx*dx+dy*dy)
};

f=lighttravelseconds(keya:$str;keyb:$str;utcms:f64):f64{
  <bodydistance(keya;keyb;utcms)*auseconds()
};

f=checklos(keya:$str;keyb:$str;utcms:f64):$los{
  let pa=planethelioxy(keya;utcms);
  let pb=planethelioxy(keyb;utcms);
  let dx=pb.x-pa.x;
  let dy=pb.y-pa.y;
  let d2=dx*dx+dy*dy;
  let dist=math.sqrt(d2);
  let t=mut.(0.0-(pa.x*dx+pa.y*dy)/d2);
  if(t<0.0){t=0.0};
  if(t>1.0){t=1.0};
  let cx=pa.x+t*dx;
  let cy=pa.y+t*dy;
  let closest=math.sqrt(cx*cx+cy*cy);
  let cosv=mut.((0.0-pa.x*dx-pa.y*dy)/(pa.r*dist));
  if(cosv<(0.0-1.0)){cosv=0.0-1.0};
  if(cosv>1.0){cosv=1.0};
  let edeg=math.acos(cosv)*180.0/3.141592653589793;
  let blocked=closest<0.01;
  let degraded=(!blocked)&&(closest<0.05);
  let msg=mut."Clear line of sight";
  if(blocked){msg=str.concat("Path passes within ";str.concat(fmtfix(closest*aukm()/1000.0;0);"k km of Sun — BLOCKED"))};
  if(degraded){msg=str.concat("Path passes within ";str.concat(fmtfix(closest*aukm()/1000000.0;2);"M km of Sun — degraded"))};
  <$los{clear:(!blocked)&&(!degraded);blocked:blocked;degraded:degraded;closestsunau:closest;edeg:edeg;message:msg}
};

(* ── Planet clocks ───────────────────────────────────────────────── *)

f=getmtc(utcms:f64):$mtc{
  let totalsols=(utcms-marsepochms())/marssolms();
  let sol=math.floor(totalsols) as i64;
  let frac=totalsols-(sol as f64);
  let h=math.floor(frac*24.0) as i64;
  let mi=math.floor((frac*24.0-(h as f64))*60.0) as i64;
  let s=math.floor(((frac*24.0-(h as f64))*60.0-(mi as f64))*60.0) as i64;
  <$mtc{sol:sol;hour:h;minute:mi;second:s;mtcstr:str.concat(padtwo(h);str.concat(":";padtwo(mi)))}
};

f=downame(idx:i64):$str{
  if(idx==0){<"Monday"};
  if(idx==1){<"Tuesday"};
  if(idx==2){<"Wednesday"};
  if(idx==3){<"Thursday"};
  if(idx==4){<"Friday"};
  if(idx==5){<"Saturday"};
  <"Sunday"
};

f=getplanettime(key:$str;utcms:f64;tzoffset:f64):$planettime{
  let p=planetget(key);
  let passedms=utcms-p.epoch+tzoffset/24.0*p.solarday;
  let totaldays=passedms/p.solarday;
  let daynumber=math.floor(totaldays) as i64;
  let dayfraction=totaldays-(daynumber as f64);
  let localhour=dayfraction*24.0;
  let h=math.floor(localhour) as i64;
  let mi=math.floor((localhour-(h as f64))*60.0) as i64;
  let s=math.floor(((localhour-(h as f64))*60.0-(mi as f64))*60.0) as i64;

  let periodinweek=mut.0;
  let isworkperiod=mut.false;
  let isworkhour=mut.false;
  if(p.earthclocksched){
    let ums=math.floor(utcms) as i64;
    let tp=time.toparts(ums as u64);
    let wd=time.weekday(ums as u64) as i64;
    periodinweek=imod(wd+6;7);
    isworkperiod=periodinweek<p.workperiodsperweek;
    isworkhour=isworkperiod&&(!(tp.hour<p.workhrsstart))&&(tp.hour<p.workhrsend)
  }el{
    let totalperiods=totaldays/p.daysperperiod;
    periodinweek=posimod(math.floor(totalperiods) as i64;p.periodsperweek);
    isworkperiod=periodinweek<p.workperiodsperweek;
    isworkhour=isworkperiod&&(!(localhour<(p.workhrsstart as f64)))&&(localhour<(p.workhrsend as f64))
  };

  let yearlength=p.sidyr/p.solarday;
  let yearnumber=math.floor(totaldays/yearlength) as i64;
  let dayinyear=math.floor(totaldays-(yearnumber as f64)*yearlength) as i64;

  let solinyear=mut.0;
  let solsperyear=mut.0;
  if(key=="mars"){
    solinyear=dayinyear;
    solsperyear=math.floor(yearlength+0.5) as i64
  };

  let ts=str.concat(padtwo(h);str.concat(":";padtwo(mi)));
  let tsf=str.concat(ts;str.concat(":";padtwo(s)));
  <$planettime{
    planet:p.pname;hour:h;minute:mi;second:s;
    localhour:localhour;dayfraction:dayfraction;daynumber:daynumber;
    dayinyear:dayinyear;yearnumber:yearnumber;
    periodinweek:periodinweek;isworkperiod:isworkperiod;isworkhour:isworkhour;
    downame:downame(imod(periodinweek;7));timestrfull:tsf;
    solinyear:solinyear;solsperyear:solsperyear
  }
};

f=findmeetingwindows(planeta:$str;planetb:$str;earthdays:i64;startms:f64):@$window{
  let step=15.0*60000.0;
  let endms=startms+(earthdays as f64)*86400000.0;
  let windows=mut.@();
  let inwindow=mut.false;
  let windowstart=mut.0.0;
  let steps=earthdays*96;
  lp(let k=0;k<steps;k=k+1){
    let tt=startms+(k as f64)*step;
    let ta=getplanettime(planeta;tt;0.0);
    let tb=getplanettime(planetb;tt;0.0);
    let overlap=ta.isworkhour&&tb.isworkhour;
    if(overlap&&(!inwindow)){
      inwindow=true;
      windowstart=tt
    };
    if((!overlap)&&inwindow){
      inwindow=false;
      windows=windows.push($window{wstart:math.floor(windowstart) as i64;wend:math.floor(tt) as i64;wdur:math.floor((tt-windowstart)/60000.0) as i64})
    }
  };
  if(inwindow){
    windows=windows.push($window{wstart:math.floor(windowstart) as i64;wend:math.floor(endms) as i64;wdur:math.floor((endms-windowstart)/60000.0) as i64})
  };
  <windows
};

f=formatlighttime(seconds:f64):$str{
  if(seconds<0.001){<"<1ms"};
  if(seconds<1.0){<str.concat(fmtfix(seconds*1000.0;0);"ms")};
  if(seconds<60.0){<str.concat(fmtfix(seconds;1);"s")};
  if(seconds<3600.0){<str.concat(fmtfix(seconds/60.0;1);"min")};
  let h=math.floor(seconds/3600.0) as i64;
  let mi=math.floor(math.fmod(seconds;3600.0)/60.0+0.5) as i64;
  <str.concat(str.fromint(h);str.concat("h ";str.concat(str.fromint(mi);"m")))
};

(* ── LTX (spec 4.3, frozen v2 planId) ────────────────────────────── *)

(* byte at index i of s, 0..255 *)
f=byteat(s:$str;i:i64):i64{
  <posimod(str.charat(s;i);256)
};

(* imul31 over the UTF-16 code units of s (s is UTF-8 encoded) *)
f=imul31utf16(s:$str):i64{
  let two32=4294967296;
  let h=mut.0;
  let n=str.len(s) as i64;
  let i=mut.0;
  lp(let guard=0;i<n;guard=guard+1){
    let b0=byteat(s;i);
    let cp=mut.b0;
    let w=mut.1;
    if(!(b0<240)){
      cp=(b0-240)*262144+(byteat(s;i+1)-128)*4096+(byteat(s;i+2)-128)*64+(byteat(s;i+3)-128);
      w=4
    }el{
      if(!(b0<224)){
        cp=(b0-224)*4096+(byteat(s;i+1)-128)*64+(byteat(s;i+2)-128);
        w=3
      }el{
        if(!(b0<192)){
          cp=(b0-192)*64+(byteat(s;i+1)-128);
          w=2
        }
      }
    };
    i=i+w;
    if(cp<65536){
      h=imod(h*31+cp;two32)
    }el{
      let c=cp-65536;
      let hi=55296+c/1024;
      let lo=56320+imod(c;1024);
      h=imod(h*31+hi;two32);
      h=imod(h*31+lo;two32)
    }
  };
  <h
};

(* JSON.stringify string escaping for the characters a plan can carry *)
f=jsonstr(s:$str):$str{
  let r=mut."\"";
  let n=str.len(s) as i64;
  lp(let i=0;i<n;i=i+1){
    let b=byteat(s;i);
    let ch=mt str.slice(s;i as u64;(i+1) as u64) {
      $ok:c c;
      $err:e ""
    };
    if(b==34){r=str.concat(r;"\\\"")}el{
      if(b==92){r=str.concat(r;"\\\\")}el{
        if(b==10){r=str.concat(r;"\\n")}el{
          if(b==9){r=str.concat(r;"\\t")}el{
            if(b==13){r=str.concat(r;"\\r")}el{
              r=str.concat(r;ch)
            }
          }
        }
      }
    }
  };
  <str.concat(r;"\"")
};

(* UTF-8 helpers. Text may also hold WTF-8 lone surrogates (from a JSON \u
   escape or an astral character cut in half), which decode like any other
   3-byte sequence. *)
f=cpwidth(b0:i64):i64{
  if(!(b0<240)){<4};
  if(!(b0<224)){<3};
  if(!(b0<192)){<2};
  <1
};

f=cpat(s:$str;i:i64):i64{
  let b0=byteat(s;i);
  if(!(b0<240)){<(b0-240)*262144+(byteat(s;i+1)-128)*4096+(byteat(s;i+2)-128)*64+(byteat(s;i+3)-128)};
  if(!(b0<224)){<(b0-224)*4096+(byteat(s;i+1)-128)*64+(byteat(s;i+2)-128)};
  if(!(b0<192)){<(b0-192)*64+(byteat(s;i+1)-128)};
  <b0
};

f=cpstr(cp:i64):$str{
  let b=str.buf();
  if(cp<128){str.addbyte(b;cp)}el{
    if(cp<2048){
      str.addbyte(b;192+cp/64);
      str.addbyte(b;128+imod(cp;64))
    }el{
      if(cp<65536){
        str.addbyte(b;224+cp/4096);
        str.addbyte(b;128+imod(cp/64;64));
        str.addbyte(b;128+imod(cp;64))
      }el{
        str.addbyte(b;240+cp/262144);
        str.addbyte(b;128+imod(cp/4096;64));
