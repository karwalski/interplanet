<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>interplanet_ltx</AssemblyName>
    <Version>1.1.0</Version>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <!-- FS3261: the plan and register values are untyped JSON trees
         (Dictionary<string, obj>) in which null is JSON null by design, and
         `box` yields objnull under F# 9 nullness; the warning is noise there. -->
    <NoWarn>$(NoWarn);FS3261</NoWarn>
    <Description>F# port of the InterPlanet LTX SDK</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="src/Upper.fs" />
    <Compile Include="src/Models.fs" />
    <Compile Include="src/Constants.fs" />
    <Compile Include="src/InterplanetLtx.fs" />
    <Compile Include="src/RestClient.fs" />
    <Compile Include="src/Security.fs" />
    <Compile Include="src/Validate.fs" />
    <Compile Include="src/V11.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ed25519 for Security.fs / V11.fs. Keep in sync with the
         #r "nuget: NSec.Cryptography, ..." lines in tests/*.fsx. -->
    <PackageReference Include="NSec.Cryptography" Version="24.4.0" />
  </ItemGroup>
</Project>
