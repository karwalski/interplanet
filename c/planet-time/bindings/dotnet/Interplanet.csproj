<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0</TargetFrameworks>
    <AssemblyName>Interplanet</AssemblyName>
    <RootNamespace>Interplanet</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0</Version>
    <Description>C# P/Invoke bindings for libinterplanet — Interplanetary Time Library</Description>
    <Authors>interplanet.live</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/karwalski/interplanet</RepositoryUrl>
  </PropertyGroup>

  <!-- Copy the native library (built by `make` in c/planet-time) next to the
       output assembly when it exists. -->
  <PropertyGroup>
    <NativeLibPath Condition="$([MSBuild]::IsOSPlatform('OSX'))">../../build/libinterplanet.dylib</NativeLibPath>
    <NativeLibPath Condition="$([MSBuild]::IsOSPlatform('Linux'))">../../build/libinterplanet.so</NativeLibPath>
    <NativeLibPath Condition="$([MSBuild]::IsOSPlatform('Windows'))">../../build/interplanet.dll</NativeLibPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(NativeLibPath)' != '' And Exists('$(NativeLibPath)')">
    <None Include="$(NativeLibPath)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
